{
  "name": "vox-ticket-watcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only VOX Cinemas seat availability watcher for City Centre Almaza.",
  "scripts": {
    "check": "node src/checker.mjs",
    "check:dry": "DRY_RUN=1 node src/checker.mjs",
    "check:scheduler": "wrangler deploy --dry-run --config scheduler/wrangler.jsonc",
    "deploy:scheduler": "wrangler deploy --config scheduler/wrangler.jsonc",
    "test:scheduler": "node --test scheduler/test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
